{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "families"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "families": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "summary",
          "attributes",
          "armourTags",
          "jewelTag",
          "weapon",
          "offhand"
        ],
        "properties": {
          "id": { "enum": ["caster", "minion", "bow", "melee", "hybrid"] },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "attributes": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["str", "dex", "int"] }
          },
          "armourTags": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "jewelTag": { "type": "string", "minLength": 1 },
          "excludedBases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "weapon": { "$ref": "#/definitions/slot" },
          "offhand": {
            "anyOf": [{ "$ref": "#/definitions/slot" }, { "type": "null" }]
          },
          "belt": { "$ref": "#/definitions/slot" }
        }
      }
    }
  },
  "definitions": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemClasses"],
      "properties": {
        "itemClasses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "bases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "defence": {
          "type": "array",
          "items": { "enum": ["armour", "evasion", "energy-shield", "ward"] }
        },
        "note": { "type": "string" }
      }
    }
  }
}