{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lordgreg/buildpath/build.schema.json",
  "title": "Build seed",
  "description": "A hand-curated build seed under src/builds/. The pipeline proves it against Path of Building and either publishes it or rejects it; it never invents one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "class",
    "ascendancyId",
    "family",
    "mainSkill",
    "summary",
    "leveling",
    "tree",
    "skillGroups",
    "ascendancyOrder",
    "bandit",
    "pantheon"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug, used in URLs and filter file names."
    },
    "name": { "type": "string", "minLength": 3 },
    "class": {
      "enum": ["Scion", "Marauder", "Ranger", "Duelist", "Witch", "Templar", "Shadow"]
    },
    "ascendancyId": { "type": "string", "minLength": 1 },
    "family": { "enum": ["caster", "minion", "bow", "melee", "hybrid"] },
    "mainSkill": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 20 },
    "leveling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brackets"],
      "properties": {
        "brackets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["until", "skills"],
            "properties": {
              "until": {
                "type": "integer",
                "minimum": 2,
                "maximum": 100,
                "description": "Level bracket upper bound; the last bracket ends at 100."
              },
              "skills": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "ascendancyOrder": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "lab"],
        "properties": {
          "node": { "type": "string", "minLength": 1 },
          "lab": { "type": "integer", "minimum": 1, "maximum": 4 }
        }
      }
    },
    "minionCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "description": "Minions whose damage the DPS figure represents. PoB reports one minion."
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 },
          "description": "Stat substrings the tree planner aims for, in priority order."
        }
      }
    },
    "skillGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "gems"],
        "properties": {
          "slot": { "type": "string", "minLength": 1 },
          "gems": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          }
        }
      }
    },
    "bandit": { "enum": ["kill-all", "oak", "kraityn", "alira"] },
    "pantheon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "type": "string", "minLength": 1 },
        "minor": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "uniques": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core": { "type": "array", "items": { "$ref": "#/$defs/unique" } },
        "optional": { "type": "array", "items": { "$ref": "#/$defs/unique" } }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "$ref": "#/$defs/section" },
        "leveling": { "$ref": "#/$defs/section" },
        "maps": { "$ref": "#/$defs/section" },
        "bossing": { "$ref": "#/$defs/section" }
      }
    }
  },
  "$defs": {
    "unique": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "slot", "baseType"],
      "properties": {
        "displayName": { "type": "string" },
        "slot": {
          "enum": ["weapon", "offhand", "helmet", "body", "gloves", "boots", "belt", "amulet", "ring", "quiver", "jewel", "flask"]
        },
        "baseType": {
          "type": "string",
          "description": "The base the filter highlights; a unique name is never a valid BaseType."
        },
        "ssfSource": { "type": "string" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "facts"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "facts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Declared fact paths this prose was written against (D25)."
        },
        "signed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "at"],
          "properties": {
            "by": { "type": "string" },
            "at": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
