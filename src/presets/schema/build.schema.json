{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lordgreg/buildpath/build.schema.json",
  "title": "Build seed",
  "description": "A hand-curated build seed under src/builds/. The pipeline proves it against Path of Building and either publishes it or rejects it; it never invents one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "class",
    "ascendancyId",
    "family",
    "mainSkill",
    "summary",
    "pros",
    "cons",
    "ratings",
    "guide",
    "leveling",
    "tree",
    "ascendancyOrder",
    "bandit",
    "pantheon",
    "season",
    "changelog",
    "wickerman",
    "stepPlan"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug, used in URLs and filter file names."
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "class": {
      "enum": [
        "Scion",
        "Marauder",
        "Ranger",
        "Duelist",
        "Witch",
        "Templar",
        "Shadow"
      ]
    },
    "ascendancyId": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "enum": [
        "caster",
        "minion",
        "bow",
        "melee",
        "hybrid"
      ]
    },
    "mainSkill": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "season": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "League id this guide was created for or last updated for. Must match a league in src/presets/leagues/index.yaml and the newest changelog entry."
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "description": "Guide updates, oldest first in the seed. The newest entry's season must match `season`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["season", "date", "notes"],
        "properties": {
          "season": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          }
        }
      }
    },
    "wickerman": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "description": "Covens league Wickerman profile; resolves the four Viscera slots for leveling, maps and bossing.",
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "stepPlan": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Profile in src/builds/config/step-plans.yaml; resolves goals, gear targets and crafting for every checkpoint."
    },
    "flagship": {
      "type": "boolean",
      "description": "A flagship requires a signed summary. A non-flagship breadth page may publish with auto-breadth."
    },
    "gateProfile": {
      "enum": ["standard", "dad"],
      "description": "The gate profile; dad lowers the damage floor but keeps the defensive gates."
    },
    "ratings": {
      "$ref": "#/$defs/ratings"
    },
    "dad": {
      "type": "boolean",
      "description": "Tanky, low-APM, forgiving build, tagged Dad in the catalogue."
    },
    "gemQualityFrom": {
      "enum": ["leveling"],
      "description": "Show and measure 20% gem quality from the first checkpoint only for a guide built around a Vaal gem. Defaults to maps-red."
    },
    "spectres": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 },
      "description": "PoB spectre metadata ids, e.g. Metadata/Monsters/TemplarSlaveDriver/TemplarSlaveDriver."
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "value": { "type": "string", "minLength": 2 }
        }
      },
      "description": "Extra PoB config inputs, e.g. useFrenzyCharges boolean=true."
    },
    "pros": {
      "$ref": "#/$defs/tradeoffs"
    },
    "cons": {
      "$ref": "#/$defs/tradeoffs"
    },
    "leveling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brackets"
      ],
      "properties": {
        "swaps": {
          "type": "array",
          "minItems": 1,
          "description": "Editorial mid-bracket gem changes; excluded from the mechanics hash.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gem", "fromLevel"],
            "properties": {
              "gem": { "type": "string", "minLength": 2 },
              "fromLevel": {
                "type": "integer",
                "minimum": 2,
                "maximum": 99,
                "description": "Character level at which the swap becomes available."
              },
              "untilLevel": {
                "type": "integer",
                "minimum": 3,
                "maximum": 100,
                "description": "Exclusive end: the level where the next skill takes over."
              },
              "replaces": {
                "type": "string",
                "minLength": 2,
                "description": "The gem this one replaces while it is used."
              },
              "note": { "type": "string", "minLength": 4 }
            }
          }
        },
        "brackets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "until",
              "skills"
            ],
            "properties": {
              "until": {
                "type": "integer",
                "minimum": 2,
                "maximum": 100,
                "description": "Level bracket upper bound; the last bracket ends at 100."
              },
              "skills": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "skillGroups": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "slot",
                    "gems"
                  ],
                  "properties": {
                    "slot": {
                      "type": "string",
                      "minLength": 1
                    },
                    "gems": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "oneOf": [
                          {
                            "type": "string",
                            "minLength": 2
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "name"
                            ],
                            "properties": {
                              "name": {
                                "type": "string",
                                "minLength": 2
                              },
                              "maxLevel": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 40
                              },
                              "note": {
                                "type": "string",
                                "minLength": 4
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              },
              "flasks": {
                "$ref": "#/$defs/flaskList"
              }
            }
          }
        }
      }
    },
    "ascendancyOrder": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node",
          "lab"
        ],
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "lab": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      }
    },
    "minionCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "description": "Minions whose damage the DPS figure represents. PoB reports one minion."
    },
    "gearProfile": {
      "type": "string",
      "minLength": 1,
      "description": "Which entry in src/builds/gear/profiles.yaml supplies the bases. Defaults to `caster`, the budget's shared slot table."
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "description": "Filter slot overrides for this build (D15). A null slot removes the family/ascendancy default, e.g. no shield on a two-handed build.",
      "properties": {
        "slots": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/slotSpec"
              }
            ]
          }
        }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          },
          "description": "Stat substrings the tree planner aims for, in priority order."
        },
        "keystones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          },
          "description": "Keystone names the build must allocate, e.g. Resolute Technique. Bought before the notable loop, inside the same point budget."
        }
      }
    },
    "skillGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "gems"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "gems": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 2
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 2
                    },
                    "maxLevel": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 40
                    },
                    "note": {
                      "type": "string",
                      "minLength": 4
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "flasks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leveling": {
          "$ref": "#/$defs/flaskList"
        },
        "maps": {
          "$ref": "#/$defs/flaskList"
        },
        "endgame": {
          "$ref": "#/$defs/flaskList"
        }
      }
    },
    "bandit": {
      "enum": [
        "kill-all",
        "oak",
        "kraityn",
        "alira"
      ]
    },
    "pantheon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "type": "string",
          "minLength": 1
        },
        "minor": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "uniques": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unique"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unique"
          }
        }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "leveling", "maps", "bossing"],
      "properties": {
        "summary": {
          "$ref": "#/$defs/section"
        },
        "leveling": {
          "$ref": "#/$defs/section"
        },
        "maps": {
          "$ref": "#/$defs/section"
        },
        "bossing": {
          "$ref": "#/$defs/section"
        }
      }
    }
  },
  "$defs": {
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tankiness", "singleTarget", "clear", "cost"],
      "properties": {
        "tankiness": { "type": "integer", "minimum": 1, "maximum": 10 },
        "singleTarget": { "type": "integer", "minimum": 1, "maximum": 10 },
        "clear": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "10 = cheapest to self-fund; 1 = expensive required gear."
        }
      }
    },
    "tradeoffs": {
      "type": "array",
      "minItems": 5,
      "description": "At least five weighted pros or cons. Weight 3 is the reason to play or avoid the build; 1 is a minor note.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "weight"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 8
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    },
    "flaskList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "name"
        ],
        "properties": {
          "slot": {
            "enum": [
              "life",
              "mana",
              "utility"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "unique": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "slot",
        "baseType"
      ],
      "properties": {
        "displayName": {
          "type": "string"
        },
        "slot": {
          "enum": [
            "weapon",
            "offhand",
            "helmet",
            "body",
            "gloves",
            "boots",
            "belt",
            "amulet",
            "ring",
            "quiver",
            "jewel",
            "flask"
          ]
        },
        "baseType": {
          "type": "string",
          "description": "The base the filter highlights; a unique name is never a valid BaseType."
        },
        "ssfSource": {
          "type": "string"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "facts"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Declared fact paths this prose was written against (D25)."
        },
        "signed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by",
            "at"
          ],
          "properties": {
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "slotSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemClasses"
      ],
      "properties": {
        "itemClasses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "defence": {
          "type": "array",
          "items": {
            "enum": [
              "armour",
              "evasion",
              "energy-shield",
              "ward"
            ]
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
