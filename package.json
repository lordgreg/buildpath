{
  "name": "filterpath",
  "private": true,
  "version": "0.27.0",
  "type": "module",
  "description": "Build-specific Path of Exile loot filters in three clicks.",
  "scripts": {
    "dev": "vite",
    "build": "npm run presets:build && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run presets:build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "presets:build": "node scripts/build-presets.mjs",
    "economy:refresh": "node scripts/refresh-economy.mjs",
    "meta:add": "node scripts/meta-add.mjs",
    "extract:repoe": "node scripts/extract-repoe.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
